{
  "name": "lrc-authoring-studio",
  "version": "0.0.1",
  "private": true,
  "description": "Static web app for creating word-timed (enhanced) LRC files from audio and lyrics.",
  "license": "BSD-2-Clause",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.gitignore"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "music-metadata": "^12.2.1"
  }
}
